# ---- Database (Railway Postgres plugin provides DATABASE_URL automatically) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yournextspot?schema=public"

# ---- Auth ----
JWT_SECRET="change-me-to-a-long-random-string"

# ---- Email OTP (Resend free tier). If unset, OTP codes print to the server console. ----
RESEND_API_KEY=""
OTP_FROM_EMAIL="YourNextSpot <onboarding@resend.dev>"

# ---- AI Concierge (Anthropic Claude). If unset, a local keyword matcher is used. ----
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# ---- Server ----
PORT="8080"
# Comma-separated allowed origins for CORS in dev (Vite runs on 5173)
CLIENT_ORIGIN="http://localhost:5173"
