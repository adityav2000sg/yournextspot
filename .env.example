# ---- Database (Railway Postgres plugin provides DATABASE_URL automatically) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yournextspot?schema=public"

# ---- Auth ----
JWT_SECRET="change-me-to-a-long-random-string"

# ---- Email OTP (Resend free tier). If unset, OTP codes print to the server console. ----
RESEND_API_KEY=""
OTP_FROM_EMAIL="YourNextSpot <onboarding@resend.dev>"

# ---- AI Concierge (Anthropic Claude). If unset, a local keyword matcher is used. ----
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# ---- Server ----
PORT="8080"
# Comma-separated allowed origins for CORS in dev (Vite runs on 5173)
CLIENT_ORIGIN="http://localhost:5173"

# ---- Frontend (Netlify/Vite) ----
# In production, set this in Netlify to the Railway API base, e.g.
# VITE_API_BASE="https://your-api.up.railway.app/api"
VITE_API_BASE=""

# ---- Member photo uploads ----
# In production, mount a persistent Railway Volume at this path.
UPLOAD_DIR="/data/uploads"
# Public API origin used to build permanent image URLs, without a trailing slash.
PUBLIC_MEDIA_BASE="https://your-api.up.railway.app"
