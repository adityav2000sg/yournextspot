{
  "name": "yournextspot",
  "version": "1.0.0",
  "private": true,
  "description": "YourNextSpot - erase decision fatigue about where to eat, drink and sip in Singapore.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:push": "npm run db:push -w server",
    "db:seed": "npm run db:seed -w server",
    "mobile:sync": "npm run build -w client && cap sync ios",
    "mobile:open": "cap open ios",
    "postinstall": "npm run db:generate -w server || true"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8"
  }
}
