generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  restaurant
  coffee
  bar
}

enum Tier {
  everyday_delight
  thoughtful_treat
  memorable_occasion
  landmark_celebration
  crown_jewel
}

enum PhotoVisibility {
  public
  private
}

enum PhotoStatus {
  pending
  approved
  rejected
}

model Spot {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  category      Category
  cuisine       String?
  price         String?
  address       String?
  area          String?
  lat           Float?
  lng           Float?
  googleMapsUrl String?
  ownerTier     Tier?
  ownerScore    Float?
  ownerVerdict  String?
  notes         String?
  wishlist      Boolean   @default(false)
  needsReview   Boolean   @default(false)
  coverImageUrl String?
  createdAt     DateTime  @default(now())
  reviews       Review[]
  saves         SavedSpot[]
  lockerSpots   LockerSpot[]
  visitEntries  VisitEntry[]
  photos        SpotPhoto[]
  reports       ContentReport[]

  @@index([category])
  @@index([area])
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  defaultLockersCreated Boolean @default(false)
  createdAt   DateTime @default(now())
  reviews     Review[]
  saves       SavedSpot[]
  lockers     Locker[]
  visitEntries VisitEntry[]
  photos      SpotPhoto[]
  contentReports ContentReport[]
  blocksMade     BlockedUser[] @relation("Blocker")
  blocksReceived BlockedUser[] @relation("Blocked")
}

model Review {
  id          String   @id @default(cuid())
  spot        Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  spotId      String
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  authorName  String
  score       Float
  tier        Tier
  verdict     String
  wouldReturn Boolean  @default(true)
  isSeed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  reports     ContentReport[]

  @@index([spotId])
  @@unique([spotId, userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model SavedSpot {
  id        String   @id @default(cuid())
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  spotId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([spotId, userId])
  @@index([userId])
  @@index([spotId])
}

model Locker {
  id          String       @id @default(cuid())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       LockerSpot[]

  @@unique([userId, name])
  @@index([userId])
}

model LockerSpot {
  id        String   @id @default(cuid())
  locker    Locker   @relation(fields: [lockerId], references: [id], onDelete: Cascade)
  lockerId  String
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  spotId    String
  createdAt DateTime @default(now())

  @@unique([lockerId, spotId])
  @@index([lockerId])
  @@index([spotId])
}

model VisitEntry {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  spot         Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  spotId       String
  visitDate    DateTime
  rating       Float
  note         String?
  favoriteItem String?
  companion    String?
  wouldReturn  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([spotId])
}

model SpotPhoto {
  id         String          @id @default(cuid())
  spot       Spot            @relation(fields: [spotId], references: [id], onDelete: Cascade)
  spotId     String
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  imageUrl   String
  caption    String?
  visibility PhotoVisibility @default(private)
  status     PhotoStatus     @default(approved)
  createdAt  DateTime        @default(now())
  reports    ContentReport[]

  @@index([spotId, visibility, status])
  @@index([userId])
}

model ContentReport {
  id         String    @id @default(cuid())
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  review     Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId   String?
  photo      SpotPhoto? @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photoId    String?
  spot       Spot?     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  spotId     String?
  reason     String
  details    String?
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([reporterId])
  @@index([reviewId, status])
  @@index([photoId, status])
  @@index([spotId, status])
}

model BlockedUser {
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}
